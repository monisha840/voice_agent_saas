# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- App ---
NODE_ENV=development
PORT_API=4000

# --- Database (matches infra/docker/docker-compose.yml defaults) ---
# DATABASE_URL is what the running API connects as. For tenant isolation to be enforced by the database it MUST be the
# restricted runtime role `voice_app` (created by migration 0012; give it a password with `pnpm db:provision-runtime-role`),
# not the owner. The owner URL below is for migrations and operator scripts only. See docs/security/rls-rollout.md.
DATABASE_URL=postgresql://voice_agent:voice_agent@localhost:5432/voice_agent_mvp
# DATABASE_URL=postgresql://voice_app:<password>@localhost:5432/voice_agent_mvp
# Owner/migration role (direct connection). Used by `pnpm db:migrate`.
# DATABASE_MIGRATION_URL=postgresql://voice_agent:voice_agent@localhost:5432/voice_agent_mvp
# Administrative connection for operator scripts (db:seed, org:create, org:list, user:admin,
# billing:assign-subscription -- see docs/operations/operator-runbook.md) and tests ONLY.
# NEVER set this on the API runtime in production: startup validation refuses it.
# DATABASE_ADMIN_URL=postgresql://voice_agent:voice_agent@localhost:5432/voice_agent_mvp

# --- AI provider selection ---
# "mock" (default, no credentials needed) or "sarvam" (real provider, requires SARVAM_API_KEY)
AI_PROVIDER=mock

# --- Telephony provider selection ---
# "mock" (default, no credentials needed) or "exotel" (real provider, requires Exotel vars below)
TELEPHONY_PROVIDER=mock

# --- Telephony (Exotel) ---
# Required only when TELEPHONY_PROVIDER=exotel. Leave blank otherwise — the
# app still starts; only the real-call route will report a configuration error.
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
# Region host from Dashboard > API Settings: api.in.exotel.com (India) or api.exotel.com (Singapore).
EXOTEL_SUBDOMAIN=
# Required for real calls: a long random string. Sent to Exotel as ?token= on our StreamUrl/StatusCallback
# and checked on every telephony request. Generate e.g. with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
EXOTEL_AGENTSTREAM_WEBHOOK_SECRET=
# Your ExoPhone (used as CallerId). The CUSTOMER's number goes in the request's From.
EXOTEL_FROM_NUMBER=
# Public https:// base of this API (e.g. an ngrok URL). Must be https; the wss:// StreamUrl is derived from it.
EXOTEL_WEBHOOK_BASE_URL=
# TEMPORARY browser "web call" channel (Test -> Web call). Off by default; also set NEXT_PUBLIC_WEB_CALL_ENABLED=true in the web app.
# WEB_CALL_ENABLED=false
# TEMPORARY experiment: read-only property endpoint for Exotel's built-in Voice Agent "API Integration" (a separate
# Exotel account). Off unless BOTH are set. The key is its own credential (24+ random chars), never the webhook secret.
# GET /api/telephony/exotel/demo/property-details?topic=pricing   (header x-api-key, or Authorization: Bearer)
EXOTEL_DEMO_API_KEY=
EXOTEL_DEMO_PROJECT_ID=
# Optional. Leave empty until Exotel confirms the right CallType for your use case.
EXOTEL_CALL_TYPE=
# Optional. The App Bazaar flow (Greeting -> Voicebot applet) that carries the audio. When set, OUTBOUND calls are placed
# into this flow (its Voicebot applet holds the wss:// URL) instead of sending StreamUrl/StreamType. Run `pnpm exotel:flow-url`
# (in apps/api) for the URL to paste into the Voicebot applet. Inbound calls to the flow's ExoPhone need no setting here.
EXOTEL_FLOW_APP_ID=
# EXOTEL_FLOW_URL_BASE=http://my.exotel.com

# --- Turn detection / network (optional) ---
# TURN_END_SILENCE_MS=700   TURN_ENERGY_THRESHOLD=500   TURN_MIN_SPEECH_MS=250   TURN_MAX_UTTERANCE_MS=15000
# Extra Host header values treated as private (comma-separated); everything else only gets /health + /api/telephony/exotel/*.
# API_PRIVATE_HOSTS=
# GET /metrics (Prometheus): 404 unless set (>= 16 chars); needs "Authorization: Bearer <token>" AND a private Host.
# METRICS_TOKEN=

# --- Cost / abuse protection (per organization; 0 disables a limit) ---
# A running call keeps the limits it started with; changing these only affects calls that start afterwards.
# MAX_CONCURRENT_CALLS_PER_ORG=10            calls in progress at once
# QUOTA_CALLS_PER_ORG_PER_DAY=1000           calls created in any rolling 24 hours (test calls included)
# QUOTA_CALL_SECONDS_PER_ORG_PER_MONTH=0     billable call seconds per calendar month (UTC); 0 = unlimited
# MAX_CALL_DURATION_MS=1800000               hard cap on one call; the agent says goodbye and hangs up. Keep below STALE_CALL_IN_PROGRESS_MS
# SILENCE_TIMEOUT_MS=20000                   no customer speech for this long -> reprompt, then end the call
# SILENCE_REPROMPTS=1                        "are you still there?" prompts before ending a silent call

# --- AI provider reliability (STT / LLM / TTS) ---
# Each provider call has a timeout and is retried with bounded exponential backoff, but ONLY for transient failures
# (timeouts, network errors, 5xx, 429). Auth, validation and configuration errors are never retried. After repeated
# failures a provider's circuit opens and calls fail fast until a probe succeeds after the cooldown.
# PROVIDER_STT_TIMEOUT_MS=10000   PROVIDER_LLM_TIMEOUT_MS=15000   PROVIDER_TTS_TIMEOUT_MS=10000
# PROVIDER_MAX_ATTEMPTS=3         PROVIDER_RETRY_BASE_DELAY_MS=250  PROVIDER_RETRY_MAX_DELAY_MS=2000
# PROVIDER_TOTAL_BUDGET_MS=30000  one call including all retries
# PROVIDER_BREAKER_FAILURE_THRESHOLD=5   PROVIDER_BREAKER_COOLDOWN_MS=30000
# TOOL_TIMEOUT_MS=10000           a tool still running after this is reported to the model as timed out

# --- Production deployment ---
# NODE_ENV=production makes the server validate its configuration at startup and refuse to start, listing every problem
# (WEB_ORIGINS set and not localhost, COOKIE_SECURE, no demo login, provider credentials for the selected providers...).
# Behind a load balancer: TRUST_PROXY=true | a hop count (1) | trusted proxy IPs/CIDRs; and list the API's internal host(s)
# in API_PRIVATE_HOSTS or dashboard requests that arrive through the proxy are answered 404.
# TRUST_PROXY=1
# Graceful shutdown: on SIGTERM new calls are refused and /ready turns 503, live calls get this long to finish before
# their sockets are closed. Set the container/orchestrator stop grace period above it.
# SHUTDOWN_DRAIN_TIMEOUT_MS=120000

# --- Inbound calls ---
# Point your provider's inbound flow at:  GET|POST  <public API base>/api/telephony/exotel/inbound?token=<EXOTEL_AGENTSTREAM_WEBHOOK_SECRET>
# (parameters CallSid, CallTo, CallFrom), and assign the dialed number to an agent in the dashboard (Agents > Phone numbers).

# --- AI (Sarvam) ---
# Required only when AI_PROVIDER=sarvam.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_TTS_MODEL=bulbul:v3

# --- EXPERIMENT: AssemblyAI realtime STT (opt-in; see apps/api/src/adapters/ai/assemblyai/ASSEMBLYAI_EXPERIMENT.md) ---
# Default is sarvam (whatever AI_PROVIDER selects). "assemblyai" is streaming-only, needs the key AND REALTIME_STT_STREAMING=true,
# and is never a fallback: a missing key fails loudly. English only (no Tamil in AssemblyAI streaming).
REALTIME_STT_PROVIDER=sarvam
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_STT_MODEL=universal-streaming-english
# Provider-side turn endpointing is pushed out so OUR turn controller decides (ForceEndpoint); flush grace is the wait for
# the provider's final after we end an utterance before settling with what we hold.
ASSEMBLYAI_STT_MIN_TURN_SILENCE_MS=5000
ASSEMBLYAI_STT_MAX_TURN_SILENCE_MS=8000
ASSEMBLYAI_STT_FLUSH_GRACE_MS=2000

# --- Streaming LLM ---
# Off by default: each model request returns the whole reply. Set true to read the reply as it is generated (Sarvam
# chat `stream: true`) and hand sentence-sized chunks onward. The reply is still synthesized whole until streaming TTS
# exists; today this only adds first-token / first-chunk timing. Only takes effect when the provider can stream.
REALTIME_LLM_STREAMING=false
# Sarvam thinking mode is ON by default and adds latency (its tokens also use up max_tokens). "" = do not send the
# field; "off" = send null (documented way to disable thinking); or low | medium | high | max. Test before relying on it.
SARVAM_LLM_REASONING_EFFORT=
# Streaming only: give up if no reply text / tool call arrives this soon, or the stream goes silent this long mid-reply.
PROVIDER_LLM_FIRST_TOKEN_TIMEOUT_MS=8000
PROVIDER_LLM_STREAM_STALL_TIMEOUT_MS=5000
# `sarvam-105b-conversations` is post-trained for real-time voice and is the default. Plain `sarvam-105b` is a reasoning model:
# it spends its token budget thinking and can return empty replies on short limits, so do not use it for live calls.

# --- Real-time (streaming) STT ---
# Off by default: each caller utterance is one batch request. Set true to stream the caller's audio to Sarvam's realtime
# endpoint while they speak. Only takes effect when the provider can stream (Sarvam, or mock for tests).
# Verify against real credentials and phone audio before relying on it (see PHASE 5 notes).
REALTIME_STT_STREAMING=false
# Audio held per call while the streaming connection is being made or is congested; beyond it that utterance fails.
REALTIME_STT_MAX_QUEUED_BYTES=262144
# Sarvam realtime endpoint settings (different endpoint and model from the batch STT above).
SARVAM_STT_REALTIME_URL=wss://api.sarvam.ai/speech-to-text-realtime/ws
SARVAM_STT_REALTIME_MODEL=saaras:v3-realtime
SARVAM_STT_REALTIME_STREAM_TYPE=fast
# codemix keeps English words (BHK, price, site visit) in English script inside Tamil/Hindi speech. With `transcribe`,
# English words are written as Tamil sounds (for example "பிஹெச்கே பிரைஸ்"), which the model then misreads.
SARVAM_STT_REALTIME_MODE=codemix
SARVAM_STT_MODE=codemix

# --- Real-time (streaming) TTS ---
# Off by default: each reply is synthesized as one batch request after the model finishes. Set true to synthesize every
# completed sentence as soon as the (streaming) LLM produces it. Needs REALTIME_LLM_STREAMING=true to have any effect on
# latency. Unverified against real Sarvam credentials; test before relying on it.
REALTIME_TTS_STREAMING=false
SARVAM_TTS_STREAM_URL=wss://api.sarvam.ai/text-to-speech/ws

# --- Frontend ---
# Use 127.0.0.1, not "localhost" — avoids IPv6 (::1) resolution issues
# on Windows where the API only listens on IPv4.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
# Public base URL of the WEB DASHBOARD: the base of every link email carries (invite, password reset, address
# verification). NOT this API (NEXT_PUBLIC_API_URL) and NOT the telephony webhook (EXOTEL_WEBHOOK_BASE_URL).
# Development defaults to the dashboard's dev server. In production it MUST be set, must be https://, and must not be
# localhost — startup validation refuses anything else, because an unusable reset link is a locked-out customer.
APP_BASE_URL=http://localhost:3000

# --- Transactional email (invites, password reset, email verification) ---
# "mock" (default, no credentials needed: nothing is delivered, every message is recorded in memory and logged
# without its body) or "resend" (real provider, requires RESEND_API_KEY and EMAIL_FROM).
# Never a fallback in either direction: with EMAIL_PROVIDER=resend and no key, production refuses to start and a send
# fails with a configuration error rather than quietly dropping the message.
EMAIL_PROVIDER=mock
# From header: "name@example.com" or "Name <name@example.com>". Required by a real provider; the domain must be one
# verified with it, or the provider rejects every send.
EMAIL_FROM=
# Optional Reply-To offered to recipients (e.g. a support address). Empty = none.
EMAIL_REPLY_TO=
# Required only when EMAIL_PROVIDER=resend. https://resend.com/api-keys
RESEND_API_KEY=
# Per-attempt bound on one send. Retries and the circuit breaker reuse the PROVIDER_* settings above; a send is only
# retried when it carries an idempotency key, so a retry can never deliver the same message twice.
# EMAIL_TIMEOUT_MS=10000

# --- Authentication security (see docs/security/mfa-and-sessions.md) ---
# Encrypts stored TOTP seeds (AES-256-GCM). base64 of 32 random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MFA_ENCRYPTION_KEY=
# off | warn (default: owners/admins are nudged) | enforce (owners/admins without MFA can only reach enrolment)
# MFA_ENFORCEMENT=warn
# off (default) | fail-open | fail-closed: screen new passwords against known breaches (HIBP range API, k-anonymity)
# PWNED_PASSWORDS=off
# Login throttling: (account, IP) pair / IP / account failures before a bounded, escalating lock
# LOGIN_PAIR_THRESHOLD=5   LOGIN_IP_THRESHOLD=30   LOGIN_ACCOUNT_THRESHOLD=20
# LOGIN_BASE_LOCK_MS=30000   LOGIN_MAX_LOCK_MS=900000   LOGIN_FAILURE_WINDOW_MS=900000
# MFA_ISSUER="Voice Agent"   REAUTH_WINDOW_MS=600000   MFA_PENDING_TTL_MS=600000   PASSWORD_MIN_LENGTH=10

# --- Shared rate limiting (PostgreSQL-backed; see docs/security/rate-limiting.md) ---
# open (default) | closed: what non-sensitive routes do when the counter store is unavailable (sensitive routes always fail closed)
# RATE_LIMIT_FAIL_MODE=open
# RATE_LIMIT_API_MAX=300   RATE_LIMIT_API_WINDOW_MS=60000   RATE_LIMIT_USER_MAX=300   RATE_LIMIT_ORG_MAX=1500
# RATE_LIMIT_CALLS_PER_ORG_MAX=10   RATE_LIMIT_CALLS_PER_ORG_WINDOW_MS=60000

# --- Media stream authentication (see docs/security/stream-tokens-and-dependencies.md, exotel-auth-capabilities.md) ---
# Per-call stream token signing keys, "kid:base64secret[,kid2:base64secret2]" (first signs, all verify). REQUIRED in
# production with TELEPHONY_PROVIDER=exotel. Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# STREAM_TOKEN_KEYS=
# STREAM_TOKEN_TTL_MS=900000   STREAM_TOKEN_MAX_USES=3
# Defaults below keep current Exotel flows working; tightening them is a recorded decision (docs/release/decisions.md D5).
# STREAM_ALLOW_STATIC_SECRET=true   STREAM_INBOUND_DIRECT_ALLOWED=true   STREAM_STATIC_REQUIRE_PENDING_STATUS=false
# STREAM_INBOUND_MAX_AGE_MS=600000   STREAM_FLOW_MAX_AGE_MS=1800000
# STREAM_ALLOWED_ACCOUNT_SIDS=        comma-separated; empty = no account-SID allow-list
# STREAM_CLAIM_STALE_MS=30000   STREAM_CLAIM_HEARTBEAT_MS=10000
# Dynamic-endpoint grants: opt-in; do NOT enable until verified against real Exotel (staging checklist GR-*).
# STREAM_REQUIRE_GRANT=false   STREAM_GRANT_TTL_MS=600000   STREAM_GRANT_MAX_USES=3

# --- Security event retention (deletion OFF; see docs/security/audit-retention.md) ---
# ENABLED is ignored unless APPROVAL_REF records the business/legal approval.
# SECURITY_EVENT_RETENTION_ENABLED=false   SECURITY_EVENT_RETENTION_APPROVAL_REF=   SECURITY_EVENT_RETENTION_ARCHIVE=false
# SECURITY_EVENT_RETENTION_DAYS_AUTH_SESSION=400   SECURITY_EVENT_RETENTION_DAYS_MFA_CONFIG=730
# SECURITY_EVENT_RETENTION_DAYS_ACCESS_DENIED=400   SECURITY_EVENT_RETENTION_DAYS_PRIVILEGED_ACTION=730
# SECURITY_EVENT_RETENTION_DAYS_OTHER=400   SECURITY_EVENT_RETENTION_BATCH_SIZE=1000   SECURITY_EVENT_RETENTION_MAX_BATCHES=20

# --- Billing policy (provisional defaults awaiting business approval; see docs/billing/README.md) ---
# BILLING_ENFORCEMENT=enforce   (off = nothing refused, status still reported)
# BILLING_ROUNDING_INCREMENT_SECONDS=60   BILLING_MIN_ANSWERED_SECONDS=3   BILLING_MAX_CALL_SECONDS=7200
# BILLING_BILL_CONNECTED_FAILED_CALLS=true   BILLING_ADMISSION_RESERVE_SECONDS=60   BILLING_GRACE_DAYS=3
