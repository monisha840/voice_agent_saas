# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- App ---
NODE_ENV=development
PORT_API=4000

# --- Database (matches infra/docker/docker-compose.yml defaults) ---
DATABASE_URL=postgresql://voice_agent:voice_agent@localhost:5432/voice_agent_mvp

# --- AI provider selection ---
# "mock" (default, no credentials needed) or "sarvam" (real provider, requires SARVAM_API_KEY)
AI_PROVIDER=mock

# --- Telephony provider selection ---
# "mock" (default, no credentials needed) or "exotel" (real provider, requires Exotel vars below)
TELEPHONY_PROVIDER=mock

# --- Telephony (Exotel) ---
# Required only when TELEPHONY_PROVIDER=exotel. Leave blank otherwise — the
# app still starts; only the real-call route will report a configuration error.
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
# Region host from Dashboard > API Settings: api.in.exotel.com (India) or api.exotel.com (Singapore).
EXOTEL_SUBDOMAIN=
# Required for real calls: a long random string. Sent to Exotel as ?token= on our StreamUrl/StatusCallback
# and checked on every telephony request. Generate e.g. with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
EXOTEL_AGENTSTREAM_WEBHOOK_SECRET=
# Your ExoPhone (used as CallerId). The CUSTOMER's number goes in the request's From.
EXOTEL_FROM_NUMBER=
# Public https:// base of this API (e.g. an ngrok URL). Must be https; the wss:// StreamUrl is derived from it.
EXOTEL_WEBHOOK_BASE_URL=
# Optional. Leave empty until Exotel confirms the right CallType for your use case.
EXOTEL_CALL_TYPE=

# --- Turn detection / network (optional) ---
# TURN_END_SILENCE_MS=700   TURN_ENERGY_THRESHOLD=500   TURN_MIN_SPEECH_MS=250   TURN_MAX_UTTERANCE_MS=15000
# Extra Host header values treated as private (comma-separated); everything else only gets /health + /api/telephony/exotel/*.
# API_PRIVATE_HOSTS=

# --- AI (Sarvam) ---
# Required only when AI_PROVIDER=sarvam.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_TTS_MODEL=bulbul:v3

# --- Frontend ---
# Use 127.0.0.1, not "localhost" — avoids IPv6 (::1) resolution issues
# on Windows where the API only listens on IPv4.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
