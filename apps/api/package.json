{
  "name": "@voice-agent/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "org:create": "tsx src/scripts/create-org.ts",
    "org:list": "tsx src/scripts/org-list.ts",
    "billing:assign-subscription": "tsx src/scripts/billing-assign-subscription.ts",
    "exotel:flow-url": "tsx src/scripts/exotel-flow-url.ts",
    "demo:call": "tsx src/scripts/demo-call.ts",
    "load:test": "tsx src/scripts/load-test.ts",
    "exotel:preflight": "tsx src/scripts/exotel-preflight.ts",
    "user:admin": "tsx src/scripts/user-admin.ts",
    "db:provision-runtime-role": "tsx src/scripts/provision-runtime-role.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.3.4",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "otpauth": "^9.5.2",
    "postgres": "^3.4.4",
    "qrcode": "^1.5.4",
    "ws": "8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8.57.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
