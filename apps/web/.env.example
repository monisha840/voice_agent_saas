# Next.js only reads env files from inside this app directory (unlike
# apps/api, which loads the repo-root .env via a custom loader). Copy
# this file to apps/web/.env.local for local development.
# Use 127.0.0.1, not "localhost" — on some systems (notably Windows)
# Node resolves "localhost" to the IPv6 ::1 address, which the API does
# not listen on, causing a silent-looking fetch failure.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
